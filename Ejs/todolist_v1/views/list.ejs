<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>to do list</title>
    <style>
        body,html{
            background-color:#3E2C23;
            color: #F5E9D8;
            display: grid;
            justify-content: center;
            align-items: center;
            font-family: monospace;
        }
        .dcont{
            border: 2px solid #E76F2E ;
            border-radius: 10px;
            padding: 20px;
            text-align: center;

        }
        h2{
            font-size: 30px;
        }
        .day{
            font-size: 25px;
            font-style: italic;
            color: #2FA4D7;
            font-weight: 800;
            margin: 0;
        }
        .status{
            letter-spacing: 3px;
        }

    </style>
</head>
<body>
    <div class="cont">
        <h1>Walecome To Days Chacking</h1>
        <div class="dcont">
            <h2>Today Is</h2>
            <p class="day">
                <%= day %>
            </p>
            
            <p class="status">
    
            </p>
        </div>

    </div>
</body>
</html>