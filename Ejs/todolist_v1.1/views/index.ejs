<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>to do list</title>
</head>
<body class="bg-[#285A48] font-mono grid justify-center items-center m-5 ">
    <h1 class="text-[#B0E4CC] text-3xl text-center "> <%= day %></h1>

    <div class="border border-[#408A71] rounded-md p-5 text-2xl text-[#B0E4CC] my-5">
        <ul>
            <!-- <li> <%= items %></li> -->
            <% for(let i = 0; i<items.length; i++) { %>
                <li class="hover:bg-[#B0E4CC] hover:text-[#285A48] p-2 font-bold font-mono delay-20 ""><%= items[i] %></li>
            <% } %>
                
        </ul>
    </div>


    <form action="/" method="post" class="grid justify-center m-5" >
        <legend></legend>
        <fieldset>
            <input type="text" name="newtodo" placeholder="Add Something To Do" class="border rounded-md px-5 py-3 text-2xl font-mono font-light text-[#B0E4CC] border-[#408A71]">
            <button type="submit" class="text-2xl font-mono font-bold px-5 py-3 ml-2 rounded-md bg-[#408A71] text-[#285A48] hover:bg-[#285A48] hover:text-[#408A71]" >ADD</button>
        </fieldset>
    </form>
</body>
</html>